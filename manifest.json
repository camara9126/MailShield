{
  "manifest_version": 3,
  "name": "MailShield",
  "version": "0.1.0",
  "description": "Analyse locale des emails pour détecter les risques de phishing.",
  "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
  "permissions": [
      "storage"
  ],

  "background": {
      "service_worker": "background.js"
  },

  "action": {
        "default_title": "Ouvrir MailShield",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },

  "web_accessible_resources": [
      {
          "resources": [
              "dashboard.html",
              "dashboard.css",
              "dashboard.js"
          ],
          "matches": [
              "https://mail.google.com/*"
          ]
      }
  ],

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": [
          "analyzer/trusted-domains.js",
          "analyzer/domain-parser.js",
          "analyzer/domain-analyzer.js",
          "analyzer/sender.js",
          "analyzer/links.js",
          "analyzer/content-analyzer.js",
          "analyzer/context-analyzer.js",
          "analyzer/behavior-analyzer.js",
          "analyzer/attachment-analyzer.js",
          "analyzer/risk-engine.js",
          "analyzer/history-manager.js",
          "storage/user-storage.js",
          "ui/ui.js",
          "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}